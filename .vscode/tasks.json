{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Select and Upload Script to NetSuite",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\project\\upload-script.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\project"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
